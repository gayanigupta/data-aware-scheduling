        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#1f78b4;" edge="1" parent="1" source="t4" target="fg5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="solid arrow = DAG edge carrying D&lt;sub&gt;ji&lt;/sub&gt; bytes&#10;dashed blue = task-to-node assignment e&lt;sub&gt;ia&lt;/sub&gt;&#10;dashed grey = inter-fog link (bandwidth B&lt;sub&gt;ba&lt;/sub&gt;)" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#666666;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
