        <mxCell id="t3" value="T3 — disaster simulation&#10;(spill trajectory)" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#1f78b4;fontColor=#0d2c54;fontSize=11;" vertex="1" parent="1">
