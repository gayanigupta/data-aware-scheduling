        <mxCell id="t2" value="T2 — preprocessing &amp; feature extraction" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#1f78b4;fontColor=#0d2c54;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="180" width="200" height="45" as="geometry"/>
