        <mxCell id="e54" value="D&lt;sub&gt;54&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0d2c54;fontSize=9;fontColor=#0d2c54;" edge="1" parent="1" source="t5" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>

