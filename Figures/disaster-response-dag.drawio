        <mxCell id="foglbl" value="Fog nodes&#10;(bandwidth B&lt;sub&gt;ba&lt;/sub&gt; per link)" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="55" y="25" width="110" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="fg1" value="FG1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#1f78b4;fontColor=#0d2c54;fontSize=11;fontStyle=1;" vertex="1" parent="1">
