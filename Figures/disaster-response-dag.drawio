        <mxCell id="fg5" value="FG5" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#1f78b4;fontColor=#0d2c54;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="550" width="80" height="40" as="geometry"/>
