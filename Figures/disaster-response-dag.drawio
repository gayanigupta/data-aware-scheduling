        <mxCell id="f12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;strokeColor=#666666;" edge="1" parent="1" source="fg1" target="fg2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;strokeColor=#666666;" edge="1" parent="1" source="fg2" target="fg3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;strokeColor=#666666;" edge="1" parent="1" source="fg3" target="fg4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;strokeColor=#666666;" edge="1" parent="1" source="fg4" target="fg5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Task DAG -->
        <mxCell id="t1" value="T1 — sensor data collection" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#1f78b4;fontColor=#0d2c54;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="200" height="45" as="geometry"/>
