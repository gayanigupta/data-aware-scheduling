        <mxCell id="sens3" value="drones" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#0d2c54;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="480" width="80" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="sens_fg1" value="raw data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;fontColor=#82b366;" edge="1" parent="1" source="sens1" target="fg1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sens_fg2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="sens2" target="fg2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sens_fg3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="sens3" target="fg3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Database / decision support -->
        <mxCell id="db" value="decision support&#10;+ temporary storage" style="shape=cylinder3;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#0d2c54;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="480" width="90" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="fg5_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="fg5" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Alerts -->
        <mxCell id="alerts" value="alerts &amp; control&#10;(shutdowns, teams)" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#0d2c54;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="480" width="100" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="fg5_al" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1f78b4;" edge="1" parent="1" source="fg5" target="alerts"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Cloud link (dead) -->
        <mxCell id="fg5_cloud" value="uplink" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#aaaaaa;fontSize=9;fontColor=#999999;" edge="1" parent="1" source="fg5" target="cloud">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="650" y="260"/><mxPoint x="800" y="260"/></Array>
