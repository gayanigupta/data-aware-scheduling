        <mxCell id="link34" value="B&lt;sub&gt;34&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;strokeColor=#666666;fontSize=9;fontColor=#666666;" edge="1" parent="1" source="fg3" target="fg4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="link45" value="B&lt;sub&gt;45&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=0;strokeColor=#666666;fontSize=9;fontColor=#666666;" edge="1" parent="1" source="fg4" target="fg5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="link13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;strokeColor=#bbbbbb;" edge="1" parent="1" source="fg1" target="fg3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="115" y="430"/><mxPoint x="355" y="430"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="link35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;strokeColor=#bbbbbb;" edge="1" parent="1" source="fg3" target="fg5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="355" y="440"/><mxPoint x="595" y="440"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- Scheduler to fog nodes -->
        <mxCell id="sch_fg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1f78b4;" edge="1" parent="1" source="sched" target="fg1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sch_fg2" value="e&lt;sub&gt;ia&lt;/sub&gt;, l&lt;sub&gt;ia&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1f78b4;fontSize=9;fontColor=#1f78b4;" edge="1" parent="1" source="sched" target="fg2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sch_fg3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1f78b4;" edge="1" parent="1" source="sched" target="fg3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sch_fg4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1f78b4;" edge="1" parent="1" source="sched" target="fg4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sch_fg5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1f78b4;" edge="1" parent="1" source="sched" target="fg5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Sensors -->
        <mxCell id="sens1" value="pipeline sensors" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#0d2c54;fontSize=10;" vertex="1" parent="1">
